{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homework Board",
  "version": "0.1.0",
  "identifier": "com.citricsoap.homeworkboard",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Homework Board",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis", "msi"]
  }
}
